{
  "format": "agent-flow",
  "version": 2,
  "id": "three-day-program",
  "name": "Первый результат за 3 дня",
  "start": "build",
  "common": "Ты — помощник автора программы «Первый результат за 3 дня». По одному шагу, коротко, на «вы». Хвалишь за сделанное, не торопишь. Цену программы называет автор.",
  "clientCard": [
    {
      "id": "name",
      "name": "Имя",
      "about": "Как обращаться к человеку."
    },
    {
      "id": "goal",
      "name": "Цель",
      "about": "Что человек хочет получить за три дня, одной фразой."
    },
    {
      "id": "subscribed",
      "name": "Подписан на канал",
      "type": "boolean",
      "about": "Подписался ли на канал автора."
    }
  ],
  "chatNotes": [
    {
      "id": "result",
      "name": "Результат дня",
      "about": "Что человек сделал сегодня."
    }
  ],
  "tools": [],
  "anyState": {
    "exits": []
  },
  "states": [
    {
      "id": "build",
      "title": "Сборка",
      "instructions": "День 1: помочь собрать первый черновой результат по шагам задания.",
      "firstMessage": "Здравствуйте! За три дня соберём ваш первый результат. Сегодня — черновик. С чего начнём?",
      "learn": [
        "name",
        "goal"
      ],
      "nudges": {
        "afterSilence": [
          {
            "amount": 15,
            "unit": "min"
          },
          {
            "amount": 1,
            "unit": "h"
          },
          {
            "amount": 4,
            "unit": "h"
          }
        ]
      },
      "exits": [
        {
          "id": "build_done",
          "when": {
            "type": "judge",
            "text": "Человек показал готовый черновик"
          },
          "to": "polish"
        },
        {
          "id": "build_day",
          "when": {
            "type": "timer",
            "from": "state_days",
            "days": 1
          },
          "to": "polish"
        }
      ]
    },
    {
      "id": "polish",
      "title": "Доработка",
      "instructions": "День 2: довести черновик до показа людям, одна правка за раз.",
      "exits": [
        {
          "id": "polish_done",
          "when": {
            "type": "judge",
            "text": "Человек показал доработанный результат"
          },
          "to": "offer"
        },
        {
          "id": "polish_day",
          "when": {
            "type": "timer",
            "from": "state_days",
            "days": 1
          },
          "to": "offer"
        }
      ]
    },
    {
      "id": "offer",
      "title": "Продажа",
      "instructions": "День 3: подвести итог сделанного и предложить следующую ступень — программу автора.",
      "nudges": {
        "afterSilence": [
          {
            "amount": 1,
            "unit": "d"
          }
        ]
      },
      "exits": [
        {
          "id": "offer_yes",
          "when": {
            "type": "judge",
            "text": "Согласился на программу"
          },
          "to": "done"
        },
        {
          "id": "offer_no",
          "when": {
            "type": "judge",
            "text": "Прямо отказался от программы"
          },
          "to": "wrap"
        }
      ]
    },
    {
      "id": "done",
      "title": "Итог",
      "instructions": "Поблагодарить и сказать, что автор свяжется.",
      "tags": [
        "успех"
      ]
    },
    {
      "id": "wrap",
      "title": "Прощание",
      "instructions": "Поблагодарить за три дня и попрощаться. Не вести по шагам и не продавать заново."
    }
  ],
  "layout": {},
  "schedule": {
    "dayStart": "09:00",
    "nightFrom": "21:00",
    "lengthDays": 3,
    "deadlineState": "wrap",
    "firstMessages": {
      "maxPerDay": 3
    },
    "dayFrame": {
      "softFrom": 12,
      "hardAt": 15,
      "hardText": "Утром отвечу!"
    }
  },
  "sideTasks": [
    {
      "id": "subscribe",
      "text": "Предложить подписаться на канал автора @first_result",
      "when": "когда человек доволен результатом",
      "field": "subscribed"
    }
  ],
  "afterEnd": "reply"
}

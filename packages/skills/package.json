{
  "name": "@ykurilov/agent-chat-skills",
  "version": "0.87.14",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "drizzle",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "@ykurilov/agent-chat-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "@ykurilov/agent-chat-source": "./src/sqlite.ts",
      "types": "./dist/types/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./postgres": {
      "@ykurilov/agent-chat-source": "./src/postgres.ts",
      "types": "./dist/types/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./labels": {
      "@ykurilov/agent-chat-source": "./src/labels.ts",
      "types": "./dist/types/labels.d.ts",
      "import": "./dist/labels.js"
    },
    "./react": {
      "@ykurilov/agent-chat-source": "./src/react.ts",
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykurilov/agent-chat-sdk.git",
    "directory": "packages/skills"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.sqlite.ts && drizzle-kit generate --config drizzle.config.postgres.ts"
  },
  "dependencies": {
    "@ykurilov/agent-chat-core": "workspace:*",
    "ai": "7.0.122",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.0",
    "react": "~19.0.1 || ~19.1.2 || ^19.2.1"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.1",
    "pg": "^8.23.0",
    "react": "^19.3.0"
  }
}

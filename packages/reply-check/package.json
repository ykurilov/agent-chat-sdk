{
  "name": "@ykurilov/agent-chat-reply-check",
  "version": "0.74.0",
  "license": "MIT",
  "description": "Проверки ответа агента для replyChecks службы чата: чужие слова и выдуманные ссылки.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "@ykurilov/agent-chat-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykurilov/agent-chat-sdk.git",
    "directory": "packages/reply-check"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ykurilov/agent-chat-core": "workspace:*"
  }
}

{
  "name": "@ykurilov/agent-chat-storage-postgres",
  "version": "0.87.7",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "drizzle"
  ],

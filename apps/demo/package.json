{
  "name": "@ykurilov/agent-chat-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx --conditions=@ykurilov/agent-chat-source server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:quick": "playwright test --project=desktop-light --grep-invert @long",
    "test:e2e:perf": "DEMO_E2E_PERF=1 playwright test --project=perf-phone --project=perf-desktop",
    "test:e2e:dialog-latency": "DEMO_E2E_DIALOG_LATENCY=1 playwright test --project=dialog-latency"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "@tandem/ui": "npm:@ykurilov/tandem-ui@^0.7.0",
    "@ykurilov/agent-chat-attachments": "workspace:*",
    "@ykurilov/agent-chat-background": "workspace:*",
    "@ykurilov/agent-chat-core": "workspace:*",
    "@ykurilov/agent-chat-diagrams": "workspace:*",
    "@ykurilov/agent-chat-history-search": "workspace:*",
    "@ykurilov/agent-chat-images": "workspace:*",
    "@ykurilov/agent-chat-limits": "workspace:*",
    "@ykurilov/agent-chat-memory": "workspace:*",
    "@ykurilov/agent-chat-messengers": "workspace:*",
    "@ykurilov/agent-chat-react": "workspace:*",
    "@ykurilov/agent-chat-sandbox": "workspace:*",
    "@ykurilov/agent-chat-server": "workspace:*",
    "@ykurilov/agent-chat-skin-tandem": "workspace:*",
    "@ykurilov/agent-chat-storage-sqlite": "workspace:*",
    "@ykurilov/agent-chat-videos": "workspace:*",
    "@ykurilov/agent-chat-voice": "workspace:*",
    "@ykurilov/agent-chat-voice-dialog": "workspace:*",
    "@ykurilov/agent-chat-web-tools": "workspace:*",
    "ai": "7.0.122",
    "hono": "^4.13.10",
    "lucide-react": "1.33.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.19",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "vite": "^8.3.1"
  }
}

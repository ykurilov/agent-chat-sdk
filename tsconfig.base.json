{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["@ykurilov/agent-chat-source"],
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    // TypeScript 7.0 изредка путает одинаковые файлы, которые pnpm сделал одним файлом на диске (жёсткие ссылки):
    // `drizzle-orm/node-postgres` получает файл `drizzle-orm/better-sqlite3` и наоборот. Один поток этого не убирает,
    // лечит `packageImportMethod: clone-or-copy` в pnpm-workspace.yaml. Флаг оставлен до 7.1, где это исправлено.
    "singleThreaded": true
  }
}

{
  "name": "agent-chat-module",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./skins/*\" build",
    "check-rules": "node scripts/check-rules.mjs",
    "test": "node scripts/check-rules.mjs && node scripts/check-extension-bundles.mjs && vitest run --project unit",
    "test:next": "pnpm --filter @ykurilov/agent-chat-next-example test:next",
    "test:live": "node scripts/test-live.mjs",
    "test:e2e": "pnpm --filter @ykurilov/agent-chat-demo test:e2e",
    "test:e2e:quick": "pnpm --filter @ykurilov/agent-chat-demo test:e2e:quick",
    "test:e2e:perf": "pnpm --filter @ykurilov/agent-chat-demo test:e2e:perf",
    "dev": "pnpm --filter @ykurilov/agent-chat-demo dev",
    "typecheck": "pnpm -r --parallel typecheck",
    "verify": "node scripts/verify.mjs",
    "secrets:load": "node scripts/load-secrets.mjs",
    "changeset": "changeset",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "22.20.4",
    "esbuild": "0.27.7",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}

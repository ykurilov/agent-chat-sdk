{
  "name": "@ykurilov/agent-chat-skin-oduvanchik",
  "version": "0.87.3",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "TANDEM_NOTICES.md"
  ],
  "exports": {
    ".": {
      "@ykurilov/agent-chat-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "@ykurilov/agent-chat-source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./chat": {
      "@ykurilov/agent-chat-source": "./src/chat.tsx",
      "types": "./dist/types/chat.d.ts",
      "import": "./dist/chat.js"
    },
    "./sandbox": {
      "@ykurilov/agent-chat-source": "./src/sandbox/index.tsx",
      "types": "./dist/types/sandbox/index.d.ts",
      "import": "./dist/sandbox/index.js"
    },
    "./flows": {
      "@ykurilov/agent-chat-source": "./src/flows/index.ts",
      "types": "./dist/types/flows/index.d.ts",
      "import": "./dist/flows/index.js"
    },
    "./flows/styles.css": {
      "@ykurilov/agent-chat-source": "./src/flows/styles.css",
      "default": "./dist/flows/styles.css"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykurilov/agent-chat-sdk.git",
    "directory": "skins/oduvanchik"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs && cp src/styles.css dist/ && cp src/flows/styles.css dist/flows/",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tandem/ui": "npm:@ykurilov/tandem-ui@^0.7.0",
    "@ykurilov/agent-chat-react": "workspace:*",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@ykurilov/ds-react": "^0.3.0",
    "@ykurilov/ds-tokens": "^0.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "class-variance-authority": "^0.7.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@ykurilov/agent-chat-sandbox": "workspace:^",
    "@ykurilov/agent-chat-flows": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@ykurilov/agent-chat-attachments": "workspace:*",
    "@ykurilov/agent-chat-web-tools": "workspace:*",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "@ykurilov/agent-chat-sandbox": "workspace:*",
    "@ykurilov/agent-chat-skin-tandem": "workspace:*",
    "@ykurilov/agent-chat-flows": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ykurilov/agent-chat-sandbox": {
      "optional": true
    },
    "@ykurilov/agent-chat-flows": {
      "optional": true
    }
  }
}
